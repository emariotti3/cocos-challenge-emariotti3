{
  "name": "cocos-challenge-backend",
  "version": "1.0.0",
  "description": "Cocos Capital backend challenge: portfolio, instrument search and order placement API",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.cjs",
    "start": "node dist/main.js",
    "start:dev": "npm run build && concurrently -k -n tsc,api -c blue,green \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,scripts,k6}/**/*.{ts,js,json}\" \"*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts,k6}/**/*.{ts,js,json}\" \"*.{js,mjs,json,md}\"",
    "test": "jest --config jest.config.js --no-watchman",
    "test:watch": "jest --config jest.config.js --no-watchman --watch",
    "test:cov": "jest --config jest.coverage.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --no-watchman --runInBand",
    "test:all": "jest --config jest.coverage.config.js --coverage=false",
    "db:migrate": "tsx src/database/cli.ts up",
    "db:migrate:undo": "tsx src/database/cli.ts down",
    "db:status": "tsx src/database/cli.ts status",
    "k6:smoke": "k6 run k6/smoke.js",
    "k6:load": "k6 run k6/load.js",
    "k6:concurrency": "tsx scripts/seed-k6.ts && k6 run k6/concurrency.js",
    "openapi:export": "npm run build && node dist/tools/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/sequelize": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/testing": "^11.1.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.6.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
