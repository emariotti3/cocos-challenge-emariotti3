# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Postgres 16). docker-compose provides this exact instance.
DATABASE_URL=postgres://cocos:cocos@localhost:5432/cocos
DB_POOL_MAX=10
# Apply the challenge seed data on migration (set to false for a clean production schema)
RUN_SEED=true

# HTTP hardening
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
RATE_LIMIT_ORDERS_LIMIT=20

# Observability
METRICS_ENABLED=true
